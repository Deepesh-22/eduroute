# ------------------------
# Frontend (Vite)
# ------------------------
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id

# Firebase (optional)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ------------------------
# MySQL (same as docker-compose + Go backend)
# Netlify Site settings → Environment variables — set these for signup/login
# ------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=eduroute_dev_password
MYSQL_DATABASE=eduroute
# Or single URL:
# MYSQL_URL=mysql://root:eduroute_dev_password@127.0.0.1:3306/eduroute
# DATABASE_URL=mysql://root:eduroute_dev_password@127.0.0.1:3306/eduroute
# Cloud MySQL often needs:
# MYSQL_SSL=true
JWT_SECRET=supersecret

# Optional: if Go API is hosted separately
# GO_API_URL=https://your-go-api.example.com

# ------------------------
# Netlify Function: send-email
# ------------------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
MAIL_FROM=EduRoute <you@gmail.com>
CORS_ORIGIN=https://eduroutee.netlify.app

# ------------------------
# Buddy AI + Live Web Search (Netlify Functions)
# ------------------------
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=eduroute
